{
  "name": "comment-scraper-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.supertj/comment-scraper-mcp",
  "description": "Read your Comment Scraper exports (Reddit and Hacker News threads) from Claude, Pi and other MCP clients. Local and read-only.",
  "type": "module",
  "bin": {
    "comment-scraper-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "pi",
    "plugin/skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./pi/extension.js"
    ],
    "skills": [
      "./plugin/skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node build.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reddit",
    "hacker-news",
    "claude",
    "pi-package",
    "comment-scraper"
  ],
  "homepage": "https://comment-scraper.com",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supertj/comment-scraper-mcp.git"
  }
}
